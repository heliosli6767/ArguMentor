{
  "name": "ArguMentor Junior",
  "slug": "argumentor-junior",
  "version": "0.1.0",
  "orientation": "portrait",
  "scheme": "argumentor",
  "userInterfaceStyle": "light",
  "splash": {
    "resizeMode": "contain",
    "backgroundColor": "#F3F5F8"
  },
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "app.argumentor.junior"
  },
  "android": {
    "adaptiveIcon": {
      "backgroundColor": "#F3F5F8"
    },
    "package": "app.argumentor.junior"
  },
  "plugins": ["expo-router"],
  "experiments": {
    "typedRoutes": true
  },
  "extra": {
    "apiBaseUrl": ""
  }
}
