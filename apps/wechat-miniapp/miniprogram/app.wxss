page{background:#f3f5f8;color:#536b88;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.page{padding:36rpx 30rpx 70rpx}.eyebrow{font-size:20rpx;letter-spacing:2rpx;color:#8a9db5;text-transform:uppercase}.title{font-size:58rpx;line-height:1.12;font-weight:650;letter-spacing:-2rpx;margin:18rpx 0;color:#506b8c}.subtitle{font-size:27rpx;line-height:1.7;color:#71839a}.card{display:block;background:#fff;border:1rpx solid #dde5ef;border-radius:28rpx;padding:30rpx;margin-top:24rpx;box-sizing:border-box}.card-title{font-size:31rpx;font-weight:600;color:#5b7392}.card-copy{font-size:24rpx;line-height:1.7;color:#76889d;margin-top:12rpx}.meta{font-size:20rpx;color:#97a5b6;margin-top:18rpx}.primary,.secondary{display:flex;align-items:center;justify-content:center;border-radius:18rpx;margin-top:24rpx;font-size:25rpx}.primary{background:#5a79a0;color:#fff}.secondary{background:#eaf0f7;color:#5d7899}.tag{display:inline-block;padding:8rpx 14rpx;border-radius:10rpx;background:#edf3fa;color:#7892b3;font-size:19rpx;margin:0 10rpx 10rpx 0}.section-title{font-size:24rpx;font-weight:600;color:#6b7f99;margin:38rpx 0 8rpx}.textarea{width:100%;min-height:180rpx;background:#f9fbfd;border:1rpx solid #dce5f0;border-radius:18rpx;padding:22rpx;box-sizing:border-box;font-size:27rpx;line-height:1.65}.safe-note{font-size:20rpx;line-height:1.65;color:#8d9caf;margin-top:18rpx}.row{display:flex;justify-content:space-between;align-items:center;gap:20rpx}.empty{text-align:center;padding:80rpx 30rpx;color:#8b9bae}.quote{border-left:5rpx solid #9bb0cb;padding-left:22rpx;font-size:26rpx;line-height:1.7;color:#607692}
