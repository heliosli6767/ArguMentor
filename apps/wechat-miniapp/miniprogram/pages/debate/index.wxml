<view class="page" wx:if="{{session}}"><text class="eyebrow">ROUND {{session.turns.length + 1}} / 4 · {{phase}}</text><view class="title">{{session.title}}</view><view wx:for="{{session.turns}}" wx:key="round" class="card"><view class="tag">Round {{item.round}}</view><view class="quote">{{item.user}}</view><view class="card-copy">Other side: {{item.opponent}}</view><view class="meta">What worked: {{item.strength}}</view><view class="meta">Next: {{item.next}}</view></view><view wx:if="{{!complete}}" class="card"><view class="card-title">Your turn</view><view class="safe-note">{{frame}}</view><textarea class="textarea" value="{{text}}" bindinput="input" maxlength="2500" placeholder="Build your argument in English."/><button class="primary" bindtap="submit">Submit this round</button></view><button wx:else class="primary" bindtap="review">Open review</button></view>
