# Copy to .env.local. Never put keys in a VITE_* variable or commit .env.local.
# Supply either provider key; OpenRouter takes priority if both are configured.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEBATE_MODEL=gpt-4.1-mini
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# For OpenRouter use a provider-qualified model, for example openai/gpt-4.1-mini.
PORT=4187
